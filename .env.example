# PatchPilot Environment Configuration

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"
PORT=3000

# Persist this directory on an attached disk for permanent hosting.
# Leave unset for local .data storage. Use a single server instance.
# PATCHPILOT_DATA_DIR="/var/data/patchpilot"

# TAVILY_API_KEY: Required for Tavily Search & Extract stale-answer verification.
# Get your API key from https://app.tavily.com
TAVILY_API_KEY=""

# BIFROST_BASE_URL: Base URL of your Bifrost gateway or proxy (e.g. http://localhost:8080/v1).
BIFROST_BASE_URL=""

# BIFROST_API_KEY: Optional API key if your Bifrost gateway enforces auth.
BIFROST_API_KEY=""

# BIFROST_MODEL: Primary model identifier routed via Bifrost (e.g. openai/gpt-4o, anthropic/claude-3-5-sonnet, etc.)
BIFROST_MODEL="default"

# BIFROST_FALLBACK_MODEL: Optional fallback model identifier if the primary model fails or is rate-limited.
BIFROST_FALLBACK_MODEL=""

# Runtime Operational Budget Limits
MAX_MODEL_CALLS_PER_RUN=4
MAX_TAVILY_SEARCHES_PER_RUN=3
MAX_TOKENS_PER_RUN=15000
# Estimated guard only; actual model pricing must be enforced in Bifrost.
MAX_COST_PER_RUN_USD=0.50
REQUEST_TIMEOUT_MS=30000
